# Council OS v3 — API Keys
# Copy this file to .env and fill in your keys.
# Run setup_wizard.py to do this interactively.

ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# OpenRouter — fallback for Byte when Anthropic credits run out
# OPENROUTER_API_KEY=your_openrouter_key_here

# Advisor (ChatGPT / GPT-4o) — OpenRouter key routes to openai/gpt-4o
# ADVISOR_API_KEY=your_openrouter_key_here
