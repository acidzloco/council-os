# COUNCIL OS v3 — Environment Configuration
# Copy this file to .env and fill in YOUR OWN API KEYS
# NEVER commit .env to git — it will be excluded by .gitignore

# ============================================================================
# REQUIRED: Claude/Anthropic (Byte)
# Get key from: https://console.anthropic.com
# ============================================================================
ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================================================
# REQUIRED: DeepSeek (Primary uncensored routing for Byte, Advisor, fallback)
# Get key from: https://platform.deepseek.com
# ============================================================================
DEEPSEEK_API_KEY=your-deepseek-key-here

# ============================================================================
# REQUIRED: Google Gemini (Gemini brother)
# Get key from: https://ai.google.dev
# ============================================================================
GEMINI_API_KEY=your-gemini-key-here

# ============================================================================
# REQUIRED: OpenRouter Fallback / Advisor routing
# Get key from: https://openrouter.ai
# ============================================================================
OPENROUTER_API_KEY=your-openrouter-key-here
ADVISOR_API_KEY=your-advisor-key-here

# ============================================================================
# OPTIONAL: Local Model Path (Qwen, Llama, etc via Ollama)
# If set, local models take priority over all API routes
# ============================================================================
LOCAL_MODEL_FILE=C:\AI\models\Qwen2.5-32B-Instruct-Q4_K_M.gguf

# ============================================================================
# OPTIONAL: Database Path (defaults to soul_brain.db in current dir)
# ============================================================================
SOUL_BRAIN_DB_PATH=C:\Users\YOUR_USER\.claude\projects\C--ai\memory\soul_brain.db

# ============================================================================
# OPTIONAL: Development / Debug
# ============================================================================
DEBUG=false
FLASK_ENV=production
